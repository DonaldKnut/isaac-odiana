# Neon / PostgreSQL
# Prefer Neon *pooler* host. Keep connection_limit low for Next.js (esp. local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=30"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (Dashboard → Developers → API keys + Webhooks)
# Local webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary (required for admin file uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Resend (https://resend.com) — verify isaacodiana.com, then switch FROM away from onboarding@
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Isaac Odiana <onboarding@resend.dev>"
